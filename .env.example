# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- Local PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credit_risk
DB_USER=postgres
DB_PASSWORD=changeme

# --- Ingestion ---
CSV_PATH=data/raw_credit_data.csv
TABLE_NAME=credit_risk_raw

# --- Kestra ---
KESTRA_DB_NAME=kestra

# --- Google Cloud (cloud / final phase) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=credit-risk-lake-yourname
BQ_DATASET=credit_risk_dw
BQ_TABLE=credit_risk_clean

# Path to the GCP service account key. The runner container uses
# /secrets/gcp-key.json automatically; set this only for host runs.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-key.json
